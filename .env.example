# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db
SECRET_KEY=generate-a-secure-random-secret-key-here-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Broker Configuration
REDIS_URL=redis://localhost:6379/0

# ==========================================
# AI/ML Configuration
# ==========================================
# Gemini 1.5 Flash API Key (for feedback generation)
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB Host/Port (if run as client, or local path)
CHROMA_DB_PATH=./ai/chromadb
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000
